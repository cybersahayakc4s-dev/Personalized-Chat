# ==============================================================================
# Cyber Sahayak Production Environment Configuration: Personalize Chat
# Target Location: /opt/company/apps/personalize-chat/.env (chmod 600)
# ==============================================================================
# All variables are strictly categorized per deployment specification:
# [REQUIRED]   - Must be configured for the container stack to boot
# [OPTIONAL]   - Sensible defaults exist in server/app/core/config.py
# [SECRET]     - High-entropy cryptographic or access credentials
# [DATABASE]   - PostgreSQL database connection settings
# [AUTH]       - JWT authentication and admin bootstrap configuration
# [SOCKET.IO]  - Real-time WebSocket origins and transport settings
# [STORAGE]    - File upload limits and disk storage controls
# [EMAIL]      - Email delivery configuration (Not currently implemented in app)
# [PRODUCTION] - Settings specific to the VPS production environment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECRETS & SECURITY KEYS [REQUIRED] [SECRET] [AUTH] [PRODUCTION]
# ------------------------------------------------------------------------------
# High-entropy JWT signing key. MUST be at least 32 characters long.
# Generate on VPS with: openssl rand -hex 32
SECRET_KEY=replace_with_openssl_rand_hex_32_minimum_32_chars

# Isolated PostgreSQL database user password.
# Generate a strong, unique alphanumeric password (16+ chars).
POSTGRES_PASSWORD=replace_with_strong_database_password_16_chars_min

# Initial bootstrap password for the platform Main-Admin (CEO).
# Used strictly for the first-time account initialization.
INITIAL_ADMIN_PASSWORD=replace_with_strong_initial_admin_password_12_chars_min

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION [REQUIRED] [DATABASE] [PRODUCTION]
# ------------------------------------------------------------------------------
# Application-specific database name and user for container isolation.
# These will be initialized within the dedicated personalize_chat_db container.
POSTGRES_USER=personalize_chat_app
POSTGRES_DB=personalize_chat_prod

# Full SQLAlchemy database connection URL.
# Assembled automatically in docker-compose.yml, or specify explicitly if needed:
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 3. PRODUCTION ENVIRONMENT & NETWORKING [REQUIRED] [PRODUCTION] [SOCKET.IO]
# ------------------------------------------------------------------------------
# Application operational mode: 'production', 'development', or 'testing'
ENVIRONMENT=production

# Loopback host port bound by personalize_chat_client for company-nginx upstream.
# Binds strictly to 127.0.0.1 on the VPS to prevent external port 80/443 conflict.
APP_PORT=8085

# Allowed CORS & Socket.IO Origin Whitelist (comma-separated, NO trailing slash).
# In production, this MUST include your external HTTPS domain!
# Note: config.py will reject startup if ENVIRONMENT=production and only localhost is present.
ALLOWED_ORIGINS=https://chat.company.internal,http://127.0.0.1:8085

# ------------------------------------------------------------------------------
# 4. INITIAL ADMIN BOOTSTRAP [REQUIRED] [AUTH] [PRODUCTION]
# ------------------------------------------------------------------------------
# Email address and display name for the initial Main-Admin account.
INITIAL_ADMIN_EMAIL=admin@company.internal
INITIAL_ADMIN_NAME=Main Admin

# ------------------------------------------------------------------------------
# 5. STORAGE & UPLOAD LIMITS [OPTIONAL] [STORAGE]
# ------------------------------------------------------------------------------
# Default maximum file size permitted per message attachment (in megabytes).
DEFAULT_MAX_FILE_SIZE_MB=500

# Absolute ceiling up to which Team Leaders can raise team upload limits (in megabytes).
DEFAULT_LEADER_CEILING_MB=2048

# ------------------------------------------------------------------------------
# 6. AUTHENTICATION TOKEN LIFESPANS [OPTIONAL] [AUTH]
# ------------------------------------------------------------------------------
# Short-lived access token duration in minutes (used with refresh token rotation).
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Long-lived refresh token duration in days before re-authentication is required.
REFRESH_TOKEN_EXPIRE_DAYS=60

# ------------------------------------------------------------------------------
# 7. LOGGING & APPLICATION RUNTIME [OPTIONAL] [PRODUCTION]
# ------------------------------------------------------------------------------
# Structured logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# In-memory rate limiting enforcement via slowapi (True/False)
RATE_LIMIT_ENABLED=true

# ------------------------------------------------------------------------------
# 8. EMAIL SERVICE [OPTIONAL] [EMAIL] (NOT CURRENTLY IMPLEMENTED IN APP)
# ------------------------------------------------------------------------------
# The application currently does not send transactional emails (accounts and password
# resets are managed directly by Main-Admin). If an SMTP relay is added in future:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAILS_FROM_EMAIL=noreply@company.internal
