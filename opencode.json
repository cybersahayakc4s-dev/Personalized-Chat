{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "logLevel": "INFO",
  "share": "manual",
  "snapshot": true,
  "permission": {
    "edit": "allow",
    "bash": {
      "npm *": "allow",
      "pip *": "allow",
      "python *": "allow",
      "docker *": "allow",
      "git *": "allow",
      "netstat *": "allow",
      "ipconfig *": "allow",
      "pytest *": "allow",
      "*": "ask"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    }
  }
}